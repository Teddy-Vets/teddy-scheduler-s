{
  "name": "Clinic",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Clinic name"
    },
    "location": {
      "type": "string",
      "description": "Clinic address/location"
    },
    "active_days": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "description": "Active days (0=Sun, 6=Sat)"
    },
    "day_hours": {
      "type": "object",
      "description": "Per-day open/close times. Key = day index string (0-6), value = { open_time, close_time }",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "open_time": {
            "type": "string"
          },
          "close_time": {
            "type": "string"
          }
        }
      }
    },
    "open_time": {
      "type": "string",
      "description": "Default opening time HH:MM (fallback if day_hours not set)"
    },
    "close_time": {
      "type": "string",
      "description": "Default closing time HH:MM (fallback if day_hours not set)"
    },
    "overtime_threshold": {
      "type": "number",
      "description": "Weekly hours before overtime kicks in"
    },
    "min_rest_hours": {
      "type": "number",
      "description": "Minimum rest hours between shifts"
    },
    "max_consecutive_days": {
      "type": "number",
      "description": "Maximum consecutive work days"
    },
    "max_shifts_per_week": {
      "type": "number",
      "description": "Maximum shifts per week per staff"
    },
    "max_fridays_per_month": {
      "type": "number",
      "description": "Maximum Fridays per month per staff"
    },
    "shift_types": {
      "type": "array",
      "description": "Available shift types for this clinic",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "start_time": {
            "type": "string"
          },
          "end_time": {
            "type": "string"
          },
          "required_staff": {
            "type": "object",
            "additionalProperties": {
              "type": "number"
            },
            "description": "Required staff count by role (veterinarian, technician, receptionist)"
          },
          "specific_days": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "description": "Specific days for this shift (0=Sun, 6=Sat). Empty = all days."
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    }
  },
  "required": [
    "name",
    "location"
  ]
}